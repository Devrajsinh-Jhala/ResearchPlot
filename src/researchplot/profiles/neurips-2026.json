{
  "schema_version": 2,
  "id": "neurips-2026",
  "revision": "2026.08.0",
  "effective_date": "2026-08-02",
  "name": "NeurIPS 2026",
  "kind": "conference",
  "year": 2026,
  "aliases": [
    "neurips",
    "neural information processing systems",
    "conference on neural information processing systems"
  ],
  "scope": "NeurIPS 2026 main-track paper template.",
  "default_width": "full",
  "verified_on": "2026-08-02",
  "caveats": [
    "Track-specific instructions may add requirements."
  ],
  "sources": [
    {
      "id": "neurips-template",
      "title": "Official NeurIPS 2026 Formatting Instructions",
      "url": "https://media.neurips.cc/Conferences/NeurIPS2026/Formatting_Instructions_For_NeurIPS_2026.zip",
      "locator": "Formatting instructions: page layout, typography, and PDF requirements",
      "retrieved_on": "2026-08-02",
      "verified_on": "2026-08-02"
    },
    {
      "id": "neurips-cfp",
      "title": "NeurIPS 2026 Call for Papers",
      "url": "https://neurips.cc/Conferences/2026/CallForPapers",
      "locator": "Call for Papers: formatting instructions",
      "retrieved_on": "2026-08-02",
      "verified_on": "2026-08-02"
    }
  ],
  "rules": [
    {
      "id": "figure.width.full",
      "probe": "artifact.width_mm",
      "constraint": {
        "operator": "approx",
        "value": 139.7,
        "unit": "mm",
        "tolerance": 0.5
      },
      "applies_to": {
        "widths": [
          "full"
        ]
      },
      "verification": "automated",
      "phases": [
        "live",
        "file"
      ],
      "level": "required",
      "source_ids": [
        "neurips-template"
      ],
      "description": "The single-column NeurIPS text width is 5.5 inches."
    },
    {
      "id": "font.family",
      "probe": "font.families.effective",
      "constraint": {
        "operator": "subset",
        "value": [
          "Times",
          "Times New Roman",
          "serif"
        ],
        "unit": null,
        "tolerance": null
      },
      "applies_to": {},
      "verification": "automated",
      "phases": [
        "live"
      ],
      "level": "recommended",
      "source_ids": [
        "neurips-template"
      ],
      "description": "Match the conference template's serif typography."
    },
    {
      "id": "font.size.min",
      "probe": "font.size.min_pt",
      "constraint": {
        "operator": "gte",
        "value": 8,
        "unit": "pt",
        "tolerance": null
      },
      "applies_to": {},
      "verification": "automated",
      "phases": [
        "live"
      ],
      "level": "inferred",
      "source_ids": [
        "neurips-template"
      ],
      "description": "Avoid labels smaller than the template's footnote size."
    },
    {
      "id": "font.size.target",
      "probe": "font.size.max_pt",
      "constraint": {
        "operator": "eq",
        "value": 10,
        "unit": "pt",
        "tolerance": null
      },
      "applies_to": {},
      "verification": "automated",
      "phases": [
        "live"
      ],
      "level": "recommended",
      "source_ids": [
        "neurips-template"
      ],
      "description": "Match the template's normal text size."
    },
    {
      "id": "line.width.min",
      "probe": "line.width.min_pt",
      "constraint": {
        "operator": "gte",
        "value": 0.5,
        "unit": "pt",
        "tolerance": null
      },
      "applies_to": {},
      "verification": "automated",
      "phases": [
        "live"
      ],
      "level": "inferred",
      "source_ids": [
        "neurips-template"
      ],
      "description": "Conservative print-safe line-weight floor."
    },
    {
      "id": "font.pdf.type3.prohibited",
      "probe": "pdf.type3_font_count",
      "constraint": {
        "operator": "eq",
        "value": 0,
        "unit": null,
        "tolerance": null
      },
      "applies_to": {
        "output_formats": [
          "pdf"
        ]
      },
      "verification": "automated",
      "phases": [
        "file"
      ],
      "level": "required",
      "source_ids": [
        "neurips-template"
      ],
      "description": "PDFs must not contain Type 3 fonts."
    },
    {
      "id": "font.pdf.truetype_embedding.required",
      "probe": "pdf.unembedded_truetype_font_count",
      "constraint": {
        "operator": "eq",
        "value": 0,
        "unit": null,
        "tolerance": null
      },
      "applies_to": {
        "output_formats": [
          "pdf"
        ]
      },
      "verification": "automated",
      "phases": [
        "file"
      ],
      "level": "required",
      "source_ids": [
        "neurips-template"
      ],
      "description": "TrueType fonts in PDFs must be embedded."
    },
    {
      "id": "export.formats.vector",
      "probe": "artifact.format",
      "constraint": {
        "operator": "in",
        "value": [
          "pdf"
        ],
        "unit": null,
        "tolerance": null
      },
      "applies_to": {
        "content_kinds": [
          "data_visualization",
          "line_art"
        ]
      },
      "verification": "automated",
      "phases": [
        "file"
      ],
      "level": "recommended",
      "source_ids": [
        "neurips-template"
      ],
      "description": "The author kit demonstrates PDF figure inclusion."
    }
  ]
}
