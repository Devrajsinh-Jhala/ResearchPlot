{
  "schema_version": 2,
  "id": "ieee-journal",
  "revision": "2026.08.0",
  "effective_date": "2026-08-02",
  "name": "IEEE Journal",
  "kind": "journal",
  "year": null,
  "aliases": [
    "ieee",
    "ieee transactions",
    "institute of electrical and electronics engineers"
  ],
  "scope": "General IEEE journal graphics guidance; individual journals may add requirements.",
  "default_width": "single",
  "verified_on": "2026-08-02",
  "caveats": [
    "Check the target journal's author instructions for overrides."
  ],
  "sources": [
    {
      "id": "ieee-size",
      "title": "IEEE Author Center: Resolution and Size",
      "url": "https://journals.ieeeauthorcenter.ieee.org/create-your-ieee-journal-article/create-graphics-for-your-article/resolution-and-size/",
      "locator": "Resolution and Size",
      "retrieved_on": "2026-08-02",
      "verified_on": "2026-08-02"
    }
  ],
  "rules": [
    {
      "id": "figure.width.single",
      "probe": "artifact.width_mm",
      "constraint": {
        "operator": "approx",
        "value": 88.9,
        "unit": "mm",
        "tolerance": 0.5
      },
      "applies_to": {
        "widths": [
          "single"
        ]
      },
      "verification": "automated",
      "phases": [
        "live",
        "file"
      ],
      "level": "required",
      "source_ids": [
        "ieee-size"
      ],
      "description": "IEEE one-column figure width."
    },
    {
      "id": "figure.width.double",
      "probe": "artifact.width_mm",
      "constraint": {
        "operator": "approx",
        "value": 181.864,
        "unit": "mm",
        "tolerance": 0.5
      },
      "applies_to": {
        "widths": [
          "double"
        ]
      },
      "verification": "automated",
      "phases": [
        "live",
        "file"
      ],
      "level": "required",
      "source_ids": [
        "ieee-size"
      ],
      "description": "IEEE two-column figure width."
    },
    {
      "id": "font.size.target",
      "probe": "font.size.max_pt",
      "constraint": {
        "operator": "eq",
        "value": 8,
        "unit": "pt",
        "tolerance": null
      },
      "applies_to": {},
      "verification": "automated",
      "phases": [
        "live"
      ],
      "level": "inferred",
      "source_ids": [
        "ieee-size"
      ],
      "description": "Conservative readable default at final size; confirm with the journal."
    },
    {
      "id": "line.width.min",
      "probe": "line.width.min_pt",
      "constraint": {
        "operator": "gte",
        "value": 0.5,
        "unit": "pt",
        "tolerance": null
      },
      "applies_to": {},
      "verification": "automated",
      "phases": [
        "live"
      ],
      "level": "inferred",
      "source_ids": [
        "ieee-size"
      ],
      "description": "Conservative line-weight floor for print reproduction."
    },
    {
      "id": "color.grayscale.distinguishable",
      "probe": "color.non_color_distinctions",
      "constraint": {
        "operator": "eq",
        "value": true,
        "unit": null,
        "tolerance": null
      },
      "applies_to": {},
      "verification": "automated",
      "phases": [
        "live"
      ],
      "level": "recommended",
      "source_ids": [
        "ieee-size"
      ],
      "description": "Use non-color distinctions when grayscale reproduction is possible."
    },
    {
      "id": "export.formats.vector",
      "probe": "artifact.format",
      "constraint": {
        "operator": "in",
        "value": [
          "pdf",
          "eps"
        ],
        "unit": null,
        "tolerance": null
      },
      "applies_to": {
        "content_kinds": [
          "data_visualization",
          "line_art"
        ]
      },
      "verification": "automated",
      "phases": [
        "file"
      ],
      "level": "required",
      "source_ids": [
        "ieee-size"
      ],
      "description": "IEEE lists PDF, EPS, and PS as acceptable vector formats."
    },
    {
      "id": "export.formats.halftone",
      "probe": "artifact.format",
      "constraint": {
        "operator": "in",
        "value": [
          "tiff",
          "jpeg",
          "png"
        ],
        "unit": null,
        "tolerance": null
      },
      "applies_to": {
        "content_kinds": [
          "halftone",
          "photograph"
        ]
      },
      "verification": "automated",
      "phases": [
        "file"
      ],
      "level": "inferred",
      "source_ids": [
        "ieee-size"
      ],
      "description": "Common raster containers; confirm the target journal's accepted formats."
    },
    {
      "id": "export.formats.combination",
      "probe": "artifact.format",
      "constraint": {
        "operator": "in",
        "value": [
          "tiff",
          "pdf"
        ],
        "unit": null,
        "tolerance": null
      },
      "applies_to": {
        "content_kinds": [
          "combination"
        ]
      },
      "verification": "automated",
      "phases": [
        "file"
      ],
      "level": "inferred",
      "source_ids": [
        "ieee-size"
      ],
      "description": "Common containers for mixed artwork."
    },
    {
      "id": "export.formats.line_art",
      "probe": "artifact.format",
      "constraint": {
        "operator": "in",
        "value": [
          "pdf",
          "eps",
          "tiff"
        ],
        "unit": null,
        "tolerance": null
      },
      "applies_to": {
        "content_kinds": [
          "line_art"
        ]
      },
      "verification": "automated",
      "phases": [
        "file"
      ],
      "level": "recommended",
      "source_ids": [
        "ieee-size"
      ],
      "description": "Prefer vector formats for line art."
    },
    {
      "id": "export.min_dpi.halftone",
      "probe": "artifact.dpi",
      "constraint": {
        "operator": "gte",
        "value": 300,
        "unit": "dpi",
        "tolerance": null
      },
      "applies_to": {
        "output_formats": [
          "png",
          "jpeg",
          "tiff"
        ],
        "content_kinds": [
          "halftone",
          "photograph"
        ]
      },
      "verification": "automated",
      "phases": [
        "file"
      ],
      "level": "required",
      "source_ids": [
        "ieee-size"
      ],
      "description": "Color and grayscale non-vector graphics must exceed 300 DPI."
    },
    {
      "id": "export.min_dpi.combination",
      "probe": "artifact.dpi",
      "constraint": {
        "operator": "gte",
        "value": 300,
        "unit": "dpi",
        "tolerance": null
      },
      "applies_to": {
        "output_formats": [
          "png",
          "jpeg",
          "tiff"
        ],
        "content_kinds": [
          "combination"
        ]
      },
      "verification": "automated",
      "phases": [
        "file"
      ],
      "level": "required",
      "source_ids": [
        "ieee-size"
      ],
      "description": "Mixed non-vector graphics must meet the color/grayscale floor."
    },
    {
      "id": "export.min_dpi.line_art",
      "probe": "artifact.dpi",
      "constraint": {
        "operator": "gte",
        "value": 600,
        "unit": "dpi",
        "tolerance": null
      },
      "applies_to": {
        "output_formats": [
          "png",
          "jpeg",
          "tiff"
        ],
        "content_kinds": [
          "line_art"
        ]
      },
      "verification": "automated",
      "phases": [
        "file"
      ],
      "level": "required",
      "source_ids": [
        "ieee-size"
      ],
      "description": "Black-and-white line art must exceed 600 DPI."
    }
  ]
}
