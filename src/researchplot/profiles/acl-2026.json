      "id": "acl-format",
      "title": "Official ACL Proceedings Formatting Requirements",
      "url": "https://github.com/acl-org/acl-style-files/blob/master/formatting.md",
      "locator": "Formatting requirements: paper geometry, typeface, figures, and embedded fonts",
      "retrieved_on": "2026-08-02",
      "verified_on": "2026-08-02",
      "kind": "official_template",
      "publisher": "ACL 2026",
      "archive_url": null,
      "content_sha256": null
    },
    {
      "id": "acl-2026",
      "title": "ACL 2026 Main Conference Paper Instructions",
      "url": "https://2026.aclweb.org/calls/main_conference_papers/",
      "locator": "Main conference paper submission instructions",
      "retrieved_on": "2026-08-02",
      "verified_on": "2026-08-02",
      "kind": "official_guideline",
      "publisher": "ACL 2026",
      "archive_url": null,
      "content_sha256": null
    }
  ],
  "rules": [
    {
      "id": "figure.width.single",
      "probe": "artifact.width_mm",
      "constraint": {
        "operator": "approx",
        "value": 77,
        "unit": "mm",
        "tolerance": 0.5
      },
      "applies_to": {
        "widths": [
          "single"
        ]
      },
      "verification": "automated",
      "phases": [
        "live",
        "file"
      ],
      "level": "required",
      "source_ids": [
        "acl-format"
      ],
      "description": "Official ACL column width.",
      "expression": null,
      "supersedes": [],
      "rationale": null
    },
    {
      "id": "figure.width.double",
      "probe": "artifact.width_mm",
      "constraint": {
        "operator": "approx",
        "value": 160,
        "unit": "mm",
        "tolerance": 0.5
      },
      "applies_to": {
        "widths": [
          "double"
        ]
      },
      "verification": "automated",
      "phases": [
        "live",
        "file"
      ],
      "level": "required",
      "source_ids": [
        "acl-format"
      ],
      "description": "Full ACL text width across both columns.",
      "expression": null,
      "supersedes": [],
      "rationale": null
    },
    {
      "id": "font.family",
      "probe": "font.families.effective",
      "constraint": {
        "operator": "subset",
        "value": [
          "Times",
          "Times New Roman",
          "serif"
        ],
        "unit": null,
        "tolerance": null
      },
      "applies_to": {},
      "verification": "automated",
      "phases": [
        "live"
      ],
      "level": "required",
      "source_ids": [
        "acl-format"
      ],
      "description": "ACL text uses Times Roman or a documented substitute.",
      "expression": null,
      "supersedes": [],
      "rationale": null
    },
    {
      "id": "font.size.min",
      "probe": "font.size.min_pt",
      "constraint": {
        "operator": "gte",
        "value": 9,
        "unit": "pt",
        "tolerance": null
      },
      "applies_to": {},
      "verification": "automated",
      "phases": [
        "live"
      ],
      "level": "inferred",
      "source_ids": [
        "acl-format"
      ],
      "description": "Do not set figure labels below the smallest specified manuscript text.",
      "expression": null,
      "supersedes": [],
      "rationale": null
    },
    {
      "id": "font.size.target",
      "probe": "font.size.max_pt",
      "constraint": {
        "operator": "eq",
        "value": 10,
        "unit": "pt",
        "tolerance": null
      },
      "applies_to": {},
      "verification": "automated",
      "phases": [
        "live"
      ],
      "level": "recommended",
      "source_ids": [
        "acl-format"
      ],
      "description": "Match the ACL caption and abstract size at final output.",
      "expression": null,
      "supersedes": [],
      "rationale": null
    },
    {
      "id": "font.pdf.embedding.required",
      "probe": "pdf.unembedded_font_count",
      "constraint": {
        "operator": "eq",
        "value": 0,
        "unit": null,
        "tolerance": null
      },
      "applies_to": {
        "output_formats": [
          "pdf"
        ]
      },
      "verification": "automated",
      "phases": [
        "file"
      ],
      "level": "required",
      "source_ids": [
        "acl-format"
      ],
      "description": "PDFs must embed all necessary fonts.",
      "expression": null,
      "supersedes": [],
      "rationale": null
    },
    {
      "id": "export.formats.vector",
      "probe": "artifact.format",
      "constraint": {
        "operator": "in",
        "value": [
          "pdf"
        ],
        "unit": null,
        "tolerance": null
      },
      "applies_to": {
        "content_kinds": [
          "data_visualization",
          "line_art"
        ]
      },
      "verification": "automated",
      "phases": [
        "file"
      ],
      "level": "recommended",
      "source_ids": [
        "acl-format"
      ],
      "description": "Use embedded PDF vector artwork in the proceedings PDF.",
      "expression": null,
      "supersedes": [],
      "rationale": null
    }
  ],
