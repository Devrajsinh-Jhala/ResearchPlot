{
  "schema_version": 1,
  "id": "nature",
  "name": "Nature",
  "kind": "journal",
  "year": null,
  "aliases": ["nature journal", "nature flagship"],
  "scope": "Final artwork for the flagship Nature journal.",
  "default_width": "single",
  "verified_on": "2026-08-02",
  "caveats": ["Nature Portfolio titles can publish different journal-specific requirements."],
  "sources": [
    {
      "id": "nature-panels",
      "title": "Nature Research Figure Guide: Building and Exporting Figure Panels",
      "url": "https://research-figure-guide.nature.com/figures/building-and-exporting-figure-panels/",
      "verified_on": "2026-08-02"
    }
  ],
  "rules": [
    {"id": "figure.width.single", "value": 89.0, "unit": "mm", "level": "required", "source_ids": ["nature-panels"], "description": "Nature single-column width."},
    {"id": "figure.width.double", "value": 183.0, "unit": "mm", "level": "required", "source_ids": ["nature-panels"], "description": "Nature double-column width."},
    {"id": "figure.max_height", "value": 170.0, "unit": "mm", "level": "required", "source_ids": ["nature-panels"], "description": "Maximum figure height leaves space for the legend."},
    {"id": "font.family", "value": ["Arial", "Helvetica", "sans-serif"], "unit": null, "level": "required", "source_ids": ["nature-panels"], "description": "Use a standard sans-serif font such as Arial or Helvetica."},
    {"id": "font.size.min", "value": 5.0, "unit": "pt", "level": "required", "source_ids": ["nature-panels"], "description": "Minimum text size at final output size."},
    {"id": "font.size.max", "value": 7.0, "unit": "pt", "level": "required", "source_ids": ["nature-panels"], "description": "Maximum text size at final output size."},
    {"id": "font.size.target", "value": 7.0, "unit": "pt", "level": "recommended", "source_ids": ["nature-panels"], "description": "Default to the upper end of Nature's permitted range."},
    {"id": "line.width.min", "value": 0.25, "unit": "pt", "level": "required", "source_ids": ["nature-panels"], "description": "Lines thinner than this can disappear in print."},
    {"id": "figure.title.prohibited", "value": true, "unit": null, "level": "recommended", "source_ids": ["nature-panels"], "description": "Keep explanatory titles in the figure legend rather than the artwork."},
    {"id": "font.pdf.type3.prohibited", "value": true, "unit": null, "level": "required", "source_ids": ["nature-panels"], "description": "Text must remain editable and fonts must be embedded."},
    {"id": "export.formats.vector", "value": ["pdf", "eps", "svg"], "unit": null, "level": "required", "source_ids": ["nature-panels"], "description": "Nature requires editable vector artwork for main figures."},
    {"id": "export.formats.halftone", "value": ["jpeg", "tiff"], "unit": null, "level": "recommended", "source_ids": ["nature-panels"], "description": "Raster formats apply to Extended Data and image-based content."},
    {"id": "export.min_dpi.halftone", "value": 300, "unit": "dpi", "level": "recommended", "source_ids": ["nature-panels"], "description": "Extended Data images should be supplied at up to 300 DPI."}
  ]
}
