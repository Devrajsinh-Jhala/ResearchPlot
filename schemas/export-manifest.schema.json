{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Devrajsinh-Jhala/ResearchPlot/v1.0.0/schemas/export-manifest.schema.json",
  "title": "ResearchPlot single-export manifest",
  "description": "Evidence manifest written beside artifacts by Target.export().",
  "type": "object",
  "required": [
    "schema_version",
    "researchplot_version",
    "profile",
    "profile_digest",
    "sources",
    "caveats",
    "target",
    "artifacts",
    "metadata",
    "report"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "researchplot_version": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "report": {
      "$ref": "#/$defs/report"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "role",
        "width",
        "content",
        "output_format"
      ],
      "properties": {
        "role": {
          "enum": [
            "main",
            "extended_data",
            "supplementary",
            "graphical_abstract"
          ]
        },
        "width": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "content": {
          "enum": [
            "data_visualization",
            "line_art",
            "halftone",
            "combination",
            "photograph"
          ]
        },
        "output_format": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pdf",
            "eps",
            "svg",
            "png",
            "jpeg",
            "tiff",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "findings",
        "failures",
        "warnings",
        "unresolved"
      ],
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "rule_id",
        "outcome",
        "level",
        "phase",
        "verification",
        "message",
        "observed",
        "expected",
        "source_urls",
        "sources",
        "artifact",
        "suggestion"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "skip"
          ]
        },
        "level": {
          "enum": [
            "required",
            "recommended",
            "inferred"
          ]
        },
        "phase": {
          "enum": [
            "live",
            "file",
            "bundle"
          ]
        },
        "verification": {
          "enum": [
            "automated",
            "manual",
            "unsupported"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "observed": {},
        "expected": {},
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "artifact": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "suggestion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "locator",
        "retrieved_on",
        "verified_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_on": {
          "type": "string",
          "format": "date"
        },
        "verified_on": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "required": [
        "schema_version",
        "profile",
        "profile_digest",
        "sources",
        "caveats",
        "target",
        "verdict",
        "summary",
        "findings"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "profile_digest": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{64})?$"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "verdict": {
          "enum": [
            "compliant",
            "non_compliant",
            "indeterminate"
          ]
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes",
        "format"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
